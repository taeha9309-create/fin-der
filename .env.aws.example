# Copy this file to .env on the EC2 instance. Never commit the real .env file.
COMPOSE_PROJECT_NAME=finder-production
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=compose.yaml:compose.aws.yaml
APP_ENV=production

FRONTEND_PORT=80
BACKEND_PORT=8080
DB_API_PORT=8081
ML_SERVICE_PORT=8001
MULTIMODAL_SERVICE_PORT=8002
SANDBOX_SERVICE_PORT=8003
DATABASE_HOST_PORT=3307

DATABASE_NAME=finder
DATABASE_USER=finder
DATABASE_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
DATABASE_ROOT_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_PASSWORD
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ADMIN_PASSWORD

GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.1-flash-lite-preview

ANALYSIS_RETENTION_HOURS=24
CLEANUP_INTERVAL_MINUTES=60
MAX_CONCURRENT_ANALYSES=2
MAX_QUEUED_ANALYSES=20
SANDBOX_RETRY_COUNT=1
ANALYSIS_TIMEOUT_SECONDS=90
ANALYSIS_JOB_RETENTION_HOURS=24
ANALYSIS_JOB_CLEANUP_INTERVAL_MS=3600000
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3
