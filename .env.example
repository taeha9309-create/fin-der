# Copy this file to .env. Keep real secrets only in the untracked .env file.
APP_ENV=development
BACKEND_PORT=8080
DB_API_PORT=8081
FRONTEND_PORT=3000
ML_SERVICE_PORT=8001
MULTIMODAL_SERVICE_PORT=8002
SANDBOX_SERVICE_PORT=8003
ANALYSIS_RETENTION_HOURS=24
CLEANUP_INTERVAL_MINUTES=60
MAX_CONCURRENT_ANALYSES=2
MAX_QUEUED_ANALYSES=20
SANDBOX_RETRY_COUNT=1
ANALYSIS_TIMEOUT_SECONDS=90
ANALYSIS_JOB_RETENTION_HOURS=24
ANALYSIS_JOB_CLEANUP_INTERVAL_MS=3600000
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3
DATABASE_HOST=database
DATABASE_PORT=3306
DATABASE_HOST_PORT=3307
DATABASE_NAME=finder
DATABASE_USER=finder
DATABASE_PASSWORD=change-me
DATABASE_ROOT_PASSWORD=change-root-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-preview

# Optional local E2E access to a host-served fixture. Keep these commented out
# for the team-default Compose configuration. COMPOSE_PATH_SEPARATOR makes the
# same COMPOSE_FILE value work on Windows and Unix-like hosts.
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=compose.yaml:compose.local-e2e.yaml
# SANDBOX_TEST_ALLOW_HOST=host.docker.internal
# LOCAL_E2E_DNS_SERVER=1.1.1.1
# LOCAL_E2E_DNS_OPTION=use-vc

